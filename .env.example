# @BotFather dan olingan token
BOT_TOKEN=123456:ABC-DEF...

# Bosh admin Telegram ID raqami
ADMIN_ID=0

# Qo'shimcha adminlar, vergul bilan: 111,222
EXTRA_ADMINS=

# Bot username (@ siz), natija ostidagi "ulashish" tugmasi uchun
BOT_USERNAME=

DB_PATH=kelajak.db
LOG_LEVEL=INFO
TIMEZONE=Asia/Tashkent

# --- Narxlar (so'mda) ------------------------------------------------------
# Bitta test narxi va "barcha testlar" paketi narxi. Adminlar keyinchalik
# panel orqali ham o'zgartira oladi.
PRICE_UZS=9900
PRICE_ALL_UZS=24900

# --- Click ------------------------------------------------------------------
# merchant.click.uz kabinetidan olinadi.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# Click serveri bizga so'rov yuboradigan ochiq manzil (https, domen bilan).
# Deploy qilingandan keyin to'ldiriladi, masalan:
# PUBLIC_URL=https://kelajak-bot.up.railway.app
PUBLIC_URL=

# HTTP server porti. Railway/Render buni o'zi beradi — tegmasa ham bo'ladi.
PORT=8080

# Click Up ilovasiga invoice yuborish. Click xizmatingizga shu metodni
# yoqib bergandan keyin 1 qiling.
CLICK_INVOICE=0
